# Dépendances installées par npm (recréées avec « npm install »)
node_modules/

# Résultat de la compilation (reconstruit par « npm run build », publié par la GitHub Action)
dist/

# Captures d'écran de comparaison (étape 6b : directions de design), produites en local
captures/

# Fichiers d'export de sauvegarde de l'appli (données personnelles de jeu)
sac2riz-sauvegarde*.json

# Fichiers d'environnement (ne doivent jamais contenir de secret dans le dépôt)
.env
.env.*

# Journaux
*.log
npm-debug.log*

# Fichiers système
Thumbs.db
desktop.ini
.DS_Store

# Éditeurs : on ne partage que les réglages VS Code du projet
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
