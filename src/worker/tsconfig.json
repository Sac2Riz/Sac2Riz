{
  // Configuration du WEB WORKER (calculs lourds en arrière-plan).
  // Ne voit que les types WebWorker : ni DOM, ni Node.
  // Elle inclut aussi le code « pur » (types, utilitaires, moteur, logique et méta
  // des jeux) : s'il touchait au DOM par erreur, la vérification échouerait.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "WebWorker"],
    "types": [],
    "rootDir": "..",
    "outDir": "../../dist"
  },
  // Le service worker (src/service-worker.ts) est compilé ici aussi : la lib WebWorker contient
  // ses types (ServiceWorkerGlobalScope…) ; il est écrit à la racine de dist/.
  "include": [
    "./**/*.ts",
    "../service-worker.ts",
    "../types/**/*.ts",
    "../utils/**/*.ts",
    "../moteur/**/*.ts",
    "../games/*/meta.ts",
    "../games/*/logique.ts"
  ],
  "exclude": ["../types/vue.ts", "../games/_*/**"]
}
